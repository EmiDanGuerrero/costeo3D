<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.costeo3d.presentation.javafx.controller.SpoolFormController"
      spacing="16" prefWidth="480" styleClass="material-form">
    <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>
    <Label text="CATÁLOGOS" styleClass="eyebrow"/>
    <Label fx:id="formTitle" text="Nueva bobina" styleClass="form-title"/>
    <Label fx:id="formDescription" text="Elegí un material activo. MySQL asignará el ID de la bobina."
           wrapText="true" styleClass="form-description"/>
    <VBox spacing="6">
        <Label text="Material" styleClass="form-label"/>
        <ComboBox fx:id="materialCombo" maxWidth="Infinity" prefHeight="38"
                  promptText="Seleccionar material" styleClass="catalog-filter-combo"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Color" styleClass="form-label"/>
        <TextField fx:id="colorField" promptText="Ej.: Negro" styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Peso inicial (gramos)" styleClass="form-label"/>
        <TextField fx:id="initialWeightField" promptText="Ej.: 1000,00" styleClass="form-field"/>
        <Label fx:id="weightHint" text="El peso actual comenzará igual al inicial. Los consumos se registran en Producción."
               wrapText="true" styleClass="form-hint"/>
    </VBox>
    <Label fx:id="feedbackLabel" text="" wrapText="true" styleClass="form-feedback"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancelar" onAction="#cancel"
                styleClass="secondary-action"/>
        <Button fx:id="saveButton" text="Guardar" onAction="#saveSpool"
                defaultButton="true" styleClass="home-action" disable="true"/>
    </HBox>
</VBox>
