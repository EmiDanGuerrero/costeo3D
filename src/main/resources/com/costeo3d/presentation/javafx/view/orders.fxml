<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.costeo3d.presentation.javafx.controller.OrdersController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
    <content>
        <VBox spacing="16" styleClass="catalogs-page">
            <VBox spacing="10" styleClass="welcome-panel">
                <padding><Insets top="21" right="28" bottom="21" left="28"/></padding>
                <Label text="PEDIDOS" styleClass="eyebrow"/>
                <Label text="Seguimiento de pedidos" styleClass="section-title"/>
                <Label text="Consultá pedidos registrados, su presupuesto de origen y los trabajos de impresión asociados."
                       styleClass="section-description" wrapText="true"/>
            </VBox>
            <VBox spacing="12" styleClass="catalog-panel">
                <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Pedidos registrados" styleClass="catalog-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newOrderButton" text="+ Nuevo pedido" onAction="#newOrder"
                            styleClass="home-action"/>
                    <Button fx:id="refreshButton" text="Actualizar" onAction="#reloadOrders"
                            styleClass="secondary-action"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10" styleClass="catalog-filters">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Buscar" styleClass="form-label"/>
                        <TextField fx:id="searchField" promptText="ID de pedido, presupuesto o cliente"
                                   styleClass="form-field"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Estado" styleClass="form-label"/>
                        <ComboBox fx:id="statusFilterCombo" prefWidth="160" maxWidth="160"
                                  styleClass="catalog-filter-combo"/>
                    </VBox>
                    <Button text="Limpiar" onAction="#clearFilters" styleClass="secondary-action"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"
                                       prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
                    <Label fx:id="statusLabel" text="Preparando consulta..." styleClass="catalog-status"
                           wrapText="true"/>
                </HBox>
                <TableView fx:id="ordersTable" styleClass="catalog-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="quoteColumn" text="Presup. #" prefWidth="82"/>
                        <TableColumn fx:id="customerColumn" text="Cliente" prefWidth="173"/>
                        <TableColumn fx:id="createdColumn" text="Creación" prefWidth="132"/>
                        <TableColumn fx:id="jobsColumn" text="Trabajos" prefWidth="75"/>
                        <TableColumn fx:id="statusColumn" text="Estado" prefWidth="126"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label text="10 pedidos por página · Ordená desde los encabezados"
                           styleClass="catalog-pagination-hint"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="previousPageButton" text="Anterior" onAction="#previousPage"
                            styleClass="secondary-action" disable="true"/>
                    <Label fx:id="pageLabel" text="Página 1 de 1" styleClass="catalog-page-label"/>
                    <Button fx:id="nextPageButton" text="Siguiente" onAction="#nextPage"
                            styleClass="secondary-action" disable="true"/>
                </HBox>
            </VBox>
            <VBox spacing="9" styleClass="catalog-panel">
                <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                <Label fx:id="detailTitle" text="Detalle del pedido" styleClass="catalog-heading"/>
                <TextArea fx:id="detailArea" editable="false" wrapText="true"
                          prefRowCount="7" prefHeight="180" maxHeight="180"
                          text="Seleccioná un pedido para consultar sus detalles."/>
                <VBox spacing="9">
                    <Label text="Acciones del pedido" styleClass="catalog-heading"/>
                    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                        <Button fx:id="startProductionButton" text="Iniciar producción"
                                onAction="#startSelectedOrder" styleClass="home-action" disable="true"/>
                        <Button fx:id="markReadyButton" text="Marcar como listo"
                                onAction="#markSelectedReady" styleClass="secondary-action" disable="true"/>
                        <Button fx:id="deliverButton" text="Marcar entregado"
                                onAction="#deliverSelectedOrder" styleClass="secondary-action" disable="true"/>
                        <Button fx:id="cancelOrderButton" text="Cancelar pedido"
                                onAction="#cancelSelectedOrder" styleClass="secondary-action" disable="true"/>
                    </FlowPane>
                    <Label fx:id="orderActionsHintLabel"
                           text="Seleccioná un pedido para ver las acciones disponibles."
                           wrapText="true" styleClass="catalog-status"/>
                </VBox>
            </VBox>
            <VBox spacing="10" styleClass="catalog-panel">
                <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Trabajos del pedido" styleClass="catalog-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="editJobButton" text="Editar planificación" onAction="#editSelectedJob"
                            styleClass="secondary-action" disable="true"/>
                </HBox>
                <Label text="Modelo y minutos estimados pueden modificarse únicamente antes de iniciar Producción."
                       styleClass="section-description" wrapText="true"/>
                <TableView fx:id="jobsTable" styleClass="catalog-table">
                    <columns>
                        <TableColumn fx:id="jobIdColumn" text="Trabajo #" prefWidth="85"/>
                        <TableColumn fx:id="jobModelColumn" text="Modelo" prefWidth="260"/>
                        <TableColumn fx:id="jobMinutesColumn" text="Minutos" prefWidth="90"/>
                        <TableColumn fx:id="jobStatusColumn" text="Estado" prefWidth="135"/>
                    </columns>
                </TableView>
                <Label fx:id="jobHintLabel" text="Seleccioná un trabajo de impresión."
                       styleClass="catalog-status" wrapText="true"/>
            </VBox>
            <Label text="E11.3.4 · Los estados de pedido se gestionan aquí; el inicio y cierre de trabajos y consumos se gestionan en Producción."
                   styleClass="bottom-hint" wrapText="true"/>
        </VBox>
    </content>
</ScrollPane>
