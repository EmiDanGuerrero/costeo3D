<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.costeo3d.presentation.javafx.controller.JobPlanningController"
            styleClass="catalogs-page">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
            <content>
                <VBox spacing="15">
                    <padding><Insets top="20" right="22" bottom="12" left="22"/></padding>
                    <VBox spacing="7" styleClass="welcome-panel">
                        <padding><Insets top="16" bottom="16" left="20" right="20"/></padding>
                        <Label text="E11.3 · PLANIFICACIÓN" styleClass="eyebrow"/>
                        <Label text="Editar trabajo pendiente" styleClass="section-title"/>
                        <Label fx:id="jobTitle" text="Pedido y trabajo" styleClass="section-description"/>
                    </VBox>
                    <VBox spacing="12" styleClass="catalog-panel">
                        <padding><Insets top="18" bottom="18" left="20" right="20"/></padding>
                        <Label text="Modelo 3D (opcional)" styleClass="form-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ComboBox fx:id="modelCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      promptText="Trabajo sin modelo" styleClass="catalog-filter-combo"/>
                            <Button fx:id="clearModelButton" text="Sin modelo" onAction="#clearModel"
                                    styleClass="secondary-action"/>
                        </HBox>
                        <Label text="Solo se pueden elegir modelos activos nuevos; se puede conservar el modelo actual aunque esté inactivo."
                               styleClass="section-description" wrapText="true"/>
                        <Label text="Duración estimada (minutos)" styleClass="form-label"/>
                        <TextField fx:id="minutesField" promptText="Ej.: 120" styleClass="form-field"/>
                        <Label text="Los cambios no modifican el estado del trabajo, fechas ni gramos de las bobinas."
                               styleClass="catalog-status" wrapText="true"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10" styleClass="catalog-panel">
            <BorderPane.margin><Insets top="0" right="22" bottom="18" left="22"/></BorderPane.margin>
            <padding><Insets top="13" bottom="13" left="20" right="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="9">
                <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"
                                   prefHeight="18" prefWidth="18" maxHeight="18" maxWidth="18"/>
                <Label fx:id="feedbackLabel" text="Preparando formulario..." maxWidth="Infinity"
                       HBox.hgrow="ALWAYS" styleClass="catalog-status" wrapText="true"/>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="cancelButton" text="Cancelar" onAction="#cancel"
                        styleClass="secondary-action"/>
                <Button fx:id="saveButton" text="Guardar planificación" onAction="#save"
                        styleClass="home-action" disable="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
