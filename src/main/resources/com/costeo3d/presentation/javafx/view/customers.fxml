<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.costeo3d.presentation.javafx.controller.CustomersController"
      spacing="16" styleClass="catalogs-page">
    <VBox spacing="10" styleClass="welcome-panel">
        <padding><Insets top="21" right="28" bottom="21" left="28"/></padding>
        <Label text="CATÁLOGOS" styleClass="eyebrow"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Clientes" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <Label text="Registro y consulta de clientes y datos de contacto."
               wrapText="true" styleClass="section-description"/>
    </VBox>
    <VBox spacing="12" styleClass="catalog-panel">
        <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Listado de clientes" styleClass="catalog-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newCustomerButton" text="Nuevo cliente" onAction="#createCustomer"
                    styleClass="home-action"/>
            <Button fx:id="refreshButton" text="Actualizar" onAction="#reloadCustomers"
                    styleClass="secondary-action"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="editCustomerButton" text="Editar seleccionado"
                    onAction="#editSelectedCustomer" disable="true" styleClass="secondary-action"/>
            <Button fx:id="toggleStateButton" text="Activar / Desactivar"
                    onAction="#toggleSelectedCustomer" disable="true" styleClass="secondary-action"/>
        </HBox>
        <HBox spacing="10" alignment="BOTTOM_LEFT" styleClass="catalog-filters">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Buscar" styleClass="form-label"/>
                <TextField fx:id="searchField" promptText="ID, nombre, teléfono o correo"
                           minWidth="140" styleClass="form-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Estado" styleClass="form-label"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="160" maxWidth="160"
                          styleClass="catalog-filter-combo"/>
            </VBox>
            <Button text="Limpiar" onAction="#clearFilters" styleClass="secondary-action"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"
                               prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
            <Label fx:id="statusLabel" text="Preparando consulta..."
                   wrapText="true" styleClass="catalog-status"/>
        </HBox>
        <TableView fx:id="customersTable" styleClass="catalog-table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="52"/>
                <TableColumn fx:id="nameColumn" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="phoneColumn" text="Teléfono" prefWidth="135"/>
                <TableColumn fx:id="emailColumn" text="Correo electrónico" prefWidth="235"/>
                <TableColumn fx:id="statusColumn" text="Estado" prefWidth="85"/>
            </columns>
        </TableView>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="10 clientes por página · Ordenamiento por columnas"
                   styleClass="catalog-pagination-hint"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="previousPageButton" text="Anterior" onAction="#previousPage"
                    styleClass="secondary-action" disable="true"/>
            <Label fx:id="pageLabel" text="Página 1 de 1" styleClass="catalog-page-label"/>
            <Button fx:id="nextPageButton" text="Siguiente" onAction="#nextPage"
                    styleClass="secondary-action" disable="true"/>
        </HBox>
    </VBox>
</VBox>
