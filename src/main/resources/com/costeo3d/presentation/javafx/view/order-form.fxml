<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="formScroll" fitToWidth="true" hbarPolicy="NEVER"
            fx:controller="com.costeo3d.presentation.javafx.controller.OrderFormController"
            style="-fx-background: transparent; -fx-background-color: transparent;">
    <content>
        <VBox spacing="15" styleClass="catalogs-page">
            <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>
            <VBox spacing="7" styleClass="welcome-panel">
                <padding><Insets top="18" bottom="18" left="20" right="20"/></padding>
                <Label text="NUEVO PEDIDO" styleClass="eyebrow"/>
                <Label text="Nuevo pedido" styleClass="section-title"/>
                <Label text="Seleccioná un presupuesto aceptado y prepará los trabajos de impresión. Ambos se guardan juntos."
                       wrapText="true" styleClass="section-description"/>
            </VBox>
            <VBox spacing="10" styleClass="catalog-panel">
                <padding><Insets top="16" bottom="16" left="20" right="20"/></padding>
                <Label text="1. Presupuesto de origen" styleClass="catalog-heading"/>
                <Label text="Presupuesto aceptado y sin pedido" styleClass="form-label"/>
                <ComboBox fx:id="quoteCombo" maxWidth="Infinity" promptText="Seleccionar presupuesto aceptado"
                          styleClass="catalog-filter-combo"/>
                <Label fx:id="quoteHintLabel" text="Seleccioná un presupuesto aceptado y sin pedido."
                       styleClass="catalog-status" wrapText="true"/>
            </VBox>
            <VBox spacing="10" styleClass="catalog-panel">
                <padding><Insets top="16" bottom="16" left="20" right="20"/></padding>
                <Label text="2. Trabajos de impresión" styleClass="catalog-heading"/>
                <Label text="Agregá al menos un trabajo. Podés añadir varios, incluso sin un modelo de catálogo."
                       styleClass="section-description" wrapText="true"/>
                <Label text="Modelo 3D (opcional)" styleClass="form-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="modelCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              promptText="Elegir modelo o dejar sin modelo" styleClass="catalog-filter-combo"/>
                    <Button fx:id="clearModelButton" text="Sin modelo" onAction="#clearModel"
                            styleClass="secondary-action"/>
                </HBox>
                <Label fx:id="modelHintLabel" text="El modelo es opcional; también podés crear trabajos personalizados."
                       styleClass="catalog-status" wrapText="true"/>
                <Label text="Tiempo estimado del trabajo (minutos)" styleClass="form-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="minutesField" promptText="Ej.: 120" prefWidth="180"
                               styleClass="form-field"/>
                    <Button fx:id="addJobButton" text="Agregar trabajo" onAction="#addJob"
                            styleClass="secondary-action"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="jobsCountLabel" text="Trabajos agregados: 0" styleClass="catalog-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="removeJobButton" text="Quitar seleccionado" onAction="#removeJob"
                            styleClass="secondary-action" disable="true"/>
                </HBox>
                <ListView fx:id="jobsList" prefHeight="164" minHeight="132"/>
            </VBox>
            <VBox spacing="9" styleClass="catalog-panel">
                <padding><Insets top="13" bottom="13" left="20" right="20"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="9">
                    <ProgressIndicator fx:id="loadingIndicator" visible="false" managed="false"
                                       prefHeight="18" prefWidth="18" maxHeight="18" maxWidth="18"/>
                    <Label fx:id="feedbackLabel" text="Cargando datos..." styleClass="catalog-status" wrapText="true"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="cancelButton" text="Cancelar" onAction="#cancel" styleClass="secondary-action"/>
                    <Button fx:id="saveButton" text="Crear pedido" onAction="#saveOrder"
                            styleClass="home-action" disable="true"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
