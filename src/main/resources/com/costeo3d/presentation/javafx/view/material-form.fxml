<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.costeo3d.presentation.javafx.controller.MaterialFormController"
      spacing="16" prefWidth="460" styleClass="material-form">
    <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>

    <Label text="CATÁLOGOS" styleClass="eyebrow"/>
    <Label fx:id="headingLabel" text="Material" styleClass="form-title"/>
    <Label text="Ingresá los datos del material. El identificador lo asigna MySQL."
           wrapText="true" styleClass="form-description"/>

    <VBox spacing="6">
        <Label text="Marca" styleClass="form-label"/>
        <TextField fx:id="brandField" promptText="Ej.: Printalot" styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Tipo" styleClass="form-label"/>
        <TextField fx:id="typeField" promptText="Ej.: PLA" styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Acabado" styleClass="form-label"/>
        <TextField fx:id="finishField" promptText="Ej.: Mate" styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Costo por gramo" styleClass="form-label"/>
        <TextField fx:id="costField" promptText="Ej.: 0,1234" styleClass="form-field"/>
        <Label text="Podés usar coma o punto decimal. El costo no puede ser negativo."
               wrapText="true" styleClass="form-hint"/>
    </VBox>

    <Label fx:id="feedbackLabel" text="" wrapText="true" styleClass="form-feedback"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancelar" onAction="#cancel"
                styleClass="secondary-action"/>
        <Button fx:id="saveButton" text="Guardar" onAction="#saveMaterial"
                defaultButton="true" styleClass="home-action"/>
    </HBox>
</VBox>
