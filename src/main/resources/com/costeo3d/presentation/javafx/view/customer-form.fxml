<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.costeo3d.presentation.javafx.controller.CustomerFormController"
      spacing="16" prefWidth="460" styleClass="material-form">
    <padding><Insets top="26" right="28" bottom="26" left="28"/></padding>
    <Label text="CATÁLOGOS" styleClass="eyebrow"/>
    <Label fx:id="formTitleLabel" text="Nuevo cliente" styleClass="form-title"/>
    <Label fx:id="formDescriptionLabel" text="Ingresá el nombre y, si los tenés, los datos de contacto."
           wrapText="true" styleClass="form-description"/>
    <VBox spacing="6">
        <Label text="Nombre *" styleClass="form-label"/>
        <TextField fx:id="nameField" promptText="Ej.: Ana Pérez" styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Teléfono (opcional)" styleClass="form-label"/>
        <TextField fx:id="phoneField" promptText="Ej.: +54 387 ..." styleClass="form-field"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Correo electrónico (opcional)" styleClass="form-label"/>
        <TextField fx:id="emailField" promptText="Ej.: cliente@correo.com" styleClass="form-field"/>
        <Label fx:id="formHintLabel"
               text="El identificador lo asigna MySQL. Solo el nombre es obligatorio."
               wrapText="true" styleClass="form-hint"/>
    </VBox>
    <Label fx:id="feedbackLabel" text="" wrapText="true" styleClass="form-feedback"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancelar" onAction="#cancel"
                styleClass="secondary-action"/>
        <Button fx:id="saveButton" text="Guardar" onAction="#saveCustomer"
                defaultButton="true" styleClass="home-action"/>
    </HBox>
</VBox>
